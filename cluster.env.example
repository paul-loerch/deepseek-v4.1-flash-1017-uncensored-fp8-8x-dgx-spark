# cluster.env.example -- describes YOUR eight nodes. Copy it and edit the copy:
#
#     cp cluster.env.example cluster.env        # cluster.env is git-ignored
#
# launch/up.sh, down.sh and status.sh read this file with bash: write KEY=value, no spaces around "=".
# Every CHANGE_ME must be replaced, and so must every 192.0.2.x address (those are RFC 5737 documentation
# addresses). The launcher refuses to run while an example value is left in place.
#
# Layout the recipe assumes: eight nodes, one tensor-parallel rank per node, numbered in the order below.
# Rank 0 (NODE1) runs the API server and is the rendezvous (master) node. Run the launcher on NODE1.


# ---- Nodes --------------------------------------------------------------------------------------------
# ssh name of each node, rank 0 first. Anything `ssh` accepts: a hostname, an alias from ~/.ssh/config or
# an address. ssh must work from the machine that runs the launcher to every node, with keys and without
# any prompt (try: ssh NODE2 true). The node this machine is (its name equals `hostname`, or its fabric
# address below is configured here) is run directly instead of over ssh.
NODE1=CHANGE_ME
NODE2=CHANGE_ME
NODE3=CHANGE_ME
NODE4=CHANGE_ME
NODE5=CHANGE_ME
NODE6=CHANGE_ME
NODE7=CHANGE_ME
NODE8=CHANGE_ME

# Fabric address of each node: the IPv4 address on the 100G RoCE port, NOT the management address.
# Find it on each node with:   ip -br a      (the line of the fabric interface, see FABRIC_IFACE)
NODE1_FABRIC_IP=192.0.2.11
NODE2_FABRIC_IP=192.0.2.12
NODE3_FABRIC_IP=192.0.2.13
NODE4_FABRIC_IP=192.0.2.14
NODE5_FABRIC_IP=192.0.2.15
NODE6_FABRIC_IP=192.0.2.16
NODE7_FABRIC_IP=192.0.2.17
NODE8_FABRIC_IP=192.0.2.18


# ---- Fabric -------------------------------------------------------------------------------------------
# Network interface that carries the fabric address. The name must be the same on every node.
# Find it with:   ip -br a        (the interface that has NODEn_FABRIC_IP; example name: enp1s0f1np1)
# Jumbo frames (MTU 9000) are expected on it; the launcher warns if a node differs.
FABRIC_IFACE=CHANGE_ME

# RoCE device (HCA) of that same port, as NCCL names it. The same name on every node.
# Find it with:   ibdev2netdev        or        rdma link        or        ls /sys/class/infiniband
# (pick the device whose network interface is FABRIC_IFACE; example name: rocep1s0f1)
ROCE_HCA=CHANGE_ME

# Subnet that contains all eight fabric addresses. NCCL only uses RoCE addresses inside it
# (NCCL_IB_ADDR_RANGE). Same notation as `ip -br a` shows, with the host bits zeroed: a.b.c.0/24
FABRIC_CIDR=192.0.2.0/24


# ---- Files --------------------------------------------------------------------------------------------
# Directory with the model weights (config.json and the *.safetensors files). An absolute path with no
# spaces. It must exist at exactly this path on every node, with the same files: weights are read from the
# local disk of each node, never over the network. It is mounted at the same path inside the containers.
MODEL_DIR=CHANGE_ME

# Writable directory on every node for the Hugging Face cache and the TileLang JIT cache.
# It is created if missing and kept between launches, which makes later boots faster. Mounted at
# /cache/huggingface inside the containers. Any absolute path with no spaces.
HF_CACHE_DIR=/var/tmp/dsv41-hf-cache

# Directory on EVERY node that holds that node's packed Engram rows: the files engram_L<layer>_tp8_r<rank>.pack and
# .pack.json that tools/engram_pack.py writes (about 49 GB per node, on the node's NVMe, not on a network share). Layers 1 and 14
# of the Engram tables are served from these files instead of from memory. An absolute path with no spaces, the same on
# every node, mounted read-only at the same path inside the containers. The launcher checks that every node has its own
# rank's manifests. Build them after the weights are in place at MODEL_DIR (README, step 4):
#     python3 tools/engram_pack.py pack --model-dir "$MODEL_DIR" --out-dir "$ENGRAM_PACKED_DIR" --rank <0..7>
ENGRAM_PACKED_DIR=CHANGE_ME


# ---- Ports --------------------------------------------------------------------------------------------
# OpenAI-compatible API, served by rank 0 on every address of NODE1.
API_PORT=8000
# TCP port rank 0 listens on so the other ranks can join (vLLM --master-port, on NODE1_FABRIC_IP).
MASTER_PORT=25100


# ---- Containers and ssh -------------------------------------------------------------------------------
# Containers are named <CONTAINER_PREFIX>0 ... <CONTAINER_PREFIX>7 (rank 0 on NODE1 ... rank 7 on NODE8).
CONTAINER_PREFIX=dsv41-rank

# User to ssh as. Leave empty to use ssh's own default (your ~/.ssh/config or the current user).
SSH_USER=

# Extra options for every ssh call, space separated, no quotes inside. BatchMode makes ssh fail instead of
# asking for a password; the other options bound how long a dead node can stall the launcher.
SSH_OPTS="-o BatchMode=yes -o ConnectTimeout=5 -o ServerAliveInterval=5 -o ServerAliveCountMax=3"


# ---- Memory -------------------------------------------------------------------------------------------
# vLLM --gpu-memory-utilization. On GB10 the CPU and the GPU share one memory pool (121 GiB), so this is a
# share of the whole machine. vLLM checks at start-up that this much memory is free on every node (0.70
# is about 85 GiB), and refuses to start otherwise. The KV cache size is pinned separately in the recipe.
GPU_MEMORY_UTILIZATION=0.70


# ---- Optional (the defaults are usually right; remove the leading # to change one) ---------------------
# DROP_CACHES: 1 = just before launch, release page cache on every node (default 0).
#   Why: GB10 has one memory pool for the CPU, the page cache and the GPU. Reading ~300 GB of weights
#   leaves page cache behind that CUDA cannot reclaim, so vLLM can stop at start-up with "Free memory on
#   device ... is less than desired GPU memory utilization" although `free` shows plenty. Two steps run:
#     1. posix_fadvise(DONTNEED) on the model files            (no privileges needed)
#     2. sync; echo 3 > /proc/sys/vm/drop_caches                (needs passwordless sudo for this command)
#   To allow step 2, create /etc/sudoers.d/dsv41-dropcaches on every node with visudo -f, with the ssh
#   user's name in place of USER:
#     USER ALL=(root) NOPASSWD: /bin/sh -c echo\ 3\ >\ /proc/sys/vm/drop_caches
# DROP_CACHES=0
#
# MEM_AVAILABLE_MIN_GIB: preflight refuses to launch when a node has less MemAvailable than this.
# MEM_AVAILABLE_MIN_GIB=40
#
# MEM_SERVING_WARN_GIB: after the boot, warn when a node has less MemAvailable than this while serving (default 8, the
# headroom rule of this recipe: keep at least 8 GiB free on every node). Measured with the shipped
# configuration under load, the head node keeps 8 GiB or more free (its lowest point in the worst-case order was 8.08 GiB).
# MEM_SERVING_WARN_GIB=8
#
# CLEAN_SHM: 1 = after the rank containers are removed, down.sh deletes the stale /dev/shm/psm_* message rings of vLLM on
# NODE1 (default 1; only when no rank container exists there). 0 leaves them alone.
# CLEAN_SHM=1
#
# FABRIC_MTU: the MTU the fabric interface is expected to have; a different value only produces a warning.
# FABRIC_MTU=9000
#
# IDLE_GPU_POWER_MAX_W: down.sh --verify calls a GPU idle only below this power draw (and at 0 % utilization).
# IDLE_GPU_POWER_MAX_W=10
#
# NCCL_DEBUG_LEVEL: NCCL_DEBUG inside the containers (WARN, INFO, ...). INFO is very verbose.
# NCCL_DEBUG_LEVEL=WARN
